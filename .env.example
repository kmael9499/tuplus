# Destino del proxy /api en npm run dev y npm run preview.
# Sin esta variable se usa el ERP publicado en Render.
TUPLUS_API_PROXY_TARGET=https://tuplusadminpanel.onrender.com

# Para usar el ERP local, inicia ese proyecto y cambia el valor anterior por:
# TUPLUS_API_PROXY_TARGET=http://127.0.0.1:8080
