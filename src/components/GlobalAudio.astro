---
// Ruta relativa a la página (igual que el resto del sitio) para funcionar en /tuplus/ y en subcarpetas.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const depth = Math.max(0, rel.split('/').filter(Boolean).length - 1);
const audioSrc = '../'.repeat(depth) + 'audio/tuplus-fondo.mp3';
---
<audio id="tuplus-global-audio" src={audioSrc} loop preload="auto" playsinline aria-hidden="true" style="display:none"></audio>
<div class="tp-audio" id="tuplus-audio-control">
  <button type="button" class="tp-audio-trigger" id="tuplus-audio-trigger" aria-label="Abrir controles de música" aria-expanded="false" aria-controls="tuplus-audio-panel">🔊</button>
  <div class="tp-audio-panel" id="tuplus-audio-panel" role="group" aria-label="Volumen de la música" hidden>
    <button type="button" class="tp-audio-mute" id="tuplus-audio-mute" aria-label="Silenciar música" aria-pressed="false">🔇</button>
    <label class="tp-audio-sr-only" for="tuplus-audio-range">Nivel de volumen</label>
    <input type="range" id="tuplus-audio-range" min="0" max="100" step="1" value="32" aria-label="Nivel de volumen" aria-orientation="vertical" />
    <output id="tuplus-audio-value" for="tuplus-audio-range">32%</output>
  </div>
</div>
<style is:inline>
  .tp-audio{position:fixed;left:max(18px,env(safe-area-inset-left));bottom:max(18px,env(safe-area-inset-bottom));z-index:60;color:#ecd29b;font:600 12px/1 system-ui,-apple-system,"Segoe UI",sans-serif}
  .tp-audio-trigger,.tp-audio-mute{all:unset;box-sizing:border-box;display:grid;place-items:center;cursor:pointer;border:1px solid rgba(236,210,155,.3);background:rgba(10,28,39,.88);color:inherit;box-shadow:0 10px 24px rgba(0,12,20,.24);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
  .tp-audio-trigger{width:46px;height:46px;border-radius:50%;font-size:22px;transition:transform .18s,background .18s}
  .tp-audio-trigger:hover{transform:translateY(-2px);background:rgba(16,43,58,.96)}
  .tp-audio-panel{position:absolute;left:50%;bottom:calc(100% + 11px);transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;min-width:56px;padding:11px 9px 10px;border:1px solid rgba(236,210,155,.3);border-radius:18px;background:rgba(10,28,39,.94);box-shadow:0 14px 34px rgba(0,12,20,.32);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
  .tp-audio-panel[hidden]{display:none!important}
  .tp-audio-mute{width:32px;height:32px;border-radius:50%;font-size:16px;box-shadow:none}
  .tp-audio-trigger:focus-visible,.tp-audio-mute:focus-visible,.tp-audio-panel input:focus-visible{outline:2px solid #ecd29b;outline-offset:3px}
  .tp-audio-panel input[type=range]{--p:32%;-webkit-appearance:none;appearance:none;writing-mode:vertical-lr;direction:rtl;width:24px;height:112px;margin:2px 0;border-radius:999px;cursor:pointer;background:linear-gradient(0deg,#e2c785 var(--p),rgba(236,210,155,.25) var(--p))}
  .tp-audio-panel input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:#f3dfae;border:2px solid #b8913f;box-shadow:0 0 8px rgba(226,199,133,.4)}
  .tp-audio-panel input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:#f3dfae;border:2px solid #b8913f}
  .tp-audio-panel output{min-width:3ch;text-align:center;font-variant-numeric:tabular-nums;color:#dcc89d}
  .tp-audio-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  html:not([data-theme="dark"]) .tp-audio{color:#8a6422}
  html:not([data-theme="dark"]) .tp-audio-trigger,html:not([data-theme="dark"]) .tp-audio-panel{background:rgba(255,255,255,.94);border-color:rgba(158,116,46,.3);box-shadow:0 12px 28px rgba(18,44,61,.16)}
  html:not([data-theme="dark"]) .tp-audio-panel output{color:#6b5320}
  @media(max-width:640px){.tp-audio{left:max(12px,env(safe-area-inset-left));bottom:max(14px,env(safe-area-inset-bottom))}.tp-audio-trigger{width:42px;height:42px}}
</style>
<script is:inline>
  (() => {
    const audio = document.getElementById("tuplus-global-audio");
    const root = document.getElementById("tuplus-audio-control");
    const trigger = document.getElementById("tuplus-audio-trigger");
    const panel = document.getElementById("tuplus-audio-panel");
    const range = document.getElementById("tuplus-audio-range");
    const out = document.getElementById("tuplus-audio-value");
    const muteBtn = document.getElementById("tuplus-audio-mute");
    if (!audio || !root || !trigger || !panel || audio.dataset.initialized === "true") return;
    audio.dataset.initialized = "true";
    const volKey = "tuplus-global-audio-volume", muteKey = "tuplus-global-audio-muted";
    let vol = 32, muted = false;
    try {
      const v = Number(localStorage.getItem(volKey));
      if (localStorage.getItem(volKey) !== null && Number.isFinite(v)) vol = Math.min(100, Math.max(0, Math.round(v)));
      muted = localStorage.getItem(muteKey) === "1";
    } catch (_) {}
    const renderVolume = () => {
      const shown = muted ? 0 : vol;
      audio.volume = shown / 100;
      audio.muted = muted || vol === 0;
      if (range) { range.value = String(shown); range.style.setProperty("--p", shown + "%"); }
      if (out) out.textContent = shown + "%";
      trigger.textContent = audio.muted ? "🔇" : "🔊";
      trigger.setAttribute("aria-label", panel.hidden ? "Abrir controles de música" : "Cerrar controles de música");
      if (muteBtn) {
        muteBtn.textContent = audio.muted ? "🔊" : "🔇";
        muteBtn.setAttribute("aria-pressed", String(audio.muted));
        muteBtn.setAttribute("aria-label", audio.muted ? "Activar música" : "Silenciar música");
      }
    };
    const persistVolume = () => { try { localStorage.setItem(volKey, String(vol)); localStorage.setItem(muteKey, muted ? "1" : "0"); } catch (_) {} };
    const closePanel = (returnFocus = false) => {
      if (panel.hidden) return;
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      renderVolume();
      if (returnFocus) trigger.focus();
    };
    trigger.addEventListener("click", () => {
      panel.hidden = !panel.hidden;
      trigger.setAttribute("aria-expanded", String(!panel.hidden));
      renderVolume();
    });
    if (range) range.addEventListener("input", () => { vol = Number(range.value); muted = vol === 0; renderVolume(); persistVolume(); });
    if (muteBtn) muteBtn.addEventListener("click", () => {
      if (muted || audio.muted) { muted = false; if (vol === 0) vol = 32; } else { muted = true; }
      renderVolume(); persistVolume();
    });
    document.addEventListener("pointerdown", event => { if (!root.contains(event.target)) closePanel(); });
    document.addEventListener("keydown", event => { if (event.key === "Escape") closePanel(true); });
    window.addEventListener("scroll", () => closePanel(), { passive: true });
    renderVolume();
    const storageKey = "tuplus-global-audio-time";
    const savePosition = () => {
      try { if (Number.isFinite(audio.currentTime)) sessionStorage.setItem(storageKey, String(audio.currentTime)); } catch (_) {}
    };
    const startPlayback = () => audio.play().then(() => {
      window.removeEventListener("pointerdown", startPlayback);
      window.removeEventListener("keydown", startPlayback);
      window.removeEventListener("touchstart", startPlayback);
    }).catch(() => {});
    try {
      const savedTime = Number(sessionStorage.getItem(storageKey));
      if (Number.isFinite(savedTime) && savedTime > 0) {
        audio.addEventListener("loadedmetadata", () => {
          if (Number.isFinite(audio.duration) && audio.duration > 0) audio.currentTime = savedTime % audio.duration;
          startPlayback();
        }, { once: true });
      }
    } catch (_) {}
    window.addEventListener("pagehide", savePosition);
    window.addEventListener("beforeunload", savePosition);
    window.addEventListener("pointerdown", startPlayback);
    window.addEventListener("keydown", startPlayback);
    window.addEventListener("touchstart", startPlayback);
    startPlayback();
  })();
</script>
