                ><span aria-hidden="true">02</span
                ><input
                  type="radio"
                  name="partner-level"
                  value="advanced"
                  aria-labelledby="pp-rank-advanced"
                  aria-describedby="pp-rank-advanced-description" /></span
              ><span
                class="pp-level-title"
                id="pp-rank-advanced"
                data-i18n="partner.advanced"
                >Avanzado</span
              ><span
                class="pp-level-description"
                id="pp-rank-advanced-description"
                data-i18n="partner.advancedText"
                >Una propuesta para consolidar tu actividad comercial y explorar
