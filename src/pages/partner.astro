                  </option>
                  <option value="company" data-i18n="application.11">
                    Empresa o agencia
                  </option>
                </select></label
              >
              <div class="pa-company" hidden>
                <label class="pa-field"
                  ><span data-i18n="application.12"
                    >Empresa / nombre comercial</span
                  ><b aria-hidden="true">*</b
                  ><input
                    name="company"
                    type="text"
                    autocomplete="organization"
                    disabled
                    required
                    maxlength="160"
                /></label>
              </div>
              <label class="pa-field"
                ><span data-i18n="application.13">Cargo o especialidad</span
                ><b aria-hidden="true">*</b
                ><input
                  name="role"
                  type="text"
                  required
                  maxlength="160" /></label
              ><label class="pa-field"
                ><span data-i18n="application.14"
                  >Web o LinkedIn (opcional)</span
                ><input
                  name="website"
                  type="url"
                  autocomplete="url"
                  maxlength="160"
              /></label>
            </div>
          </section>
          <section
            class="pa-panel"
            data-panel="1"
            hidden
            aria-labelledby="pa-title-1"
          >
            <div class="pa-panel-head">
              <span class="pa-index" aria-hidden="true">02</span>
              <div>
                <h2 tabindex="-1" id="pa-title-1" data-i18n="application.3">
                  Mercado
                </h2>
                <p data-i18n="application.52">
                  Describe tu mercado, experiencia y las soluciones que te
                  interesan.
                </p>
              </div>
            </div>
            <div class="pa-fields">
              <label class="pa-field"
                ><span data-i18n="application.15">País de operación</span
                ><b aria-hidden="true">*</b
                ><span class="pa-country-control"><select name="country" required>
                  <option value="" data-i18n="application.32">
                    Selecciona una opción
                  </option>
                  <option translate="no" value="PE">Perú</option>
                  <option translate="no" value="PT">Portugal</option>
                  <option translate="no" value="ES">España</option>
                  <option translate="no" value="JP">Japón</option>
                  <option translate="no" value="US">Estados Unidos</option>
                  <option translate="no" value="DE">Alemania</option>
                  <option value="other" data-i18n="application.57">
                    Otro país
                  </option>
                </select><img class="pa-country-flag" alt="" aria-hidden="true" hidden></span></label
              >
              <div class="pa-other" hidden>
                <label class="pa-field"
                  ><span data-i18n="application.58">Indica el país</span
                  ><b aria-hidden="true">*</b
                  ><input
                    name="otherCountry"
                    type="text"
                    disabled
                    required
                    maxlength="160"
                /></label>
              </div>
              <label class="pa-field"
                ><span data-i18n="territory.city">Ciudad</span
                ><b aria-hidden="true">*</b
                ><input
                  name="city"
                  type="text"
                  required
                  maxlength="160" /></label
              ><label class="pa-field"><span data-i18n="territory.region">Región / provincia (opcional)</span><input name="region" maxlength="100" autocomplete="address-level1"/></label><label class="pa-field"
                ><span data-i18n="application.17">Sector de tus clientes</span
                ><b aria-hidden="true">*</b
                ><input
                  name="sector"
                  type="text"
                  required
                  maxlength="160" /></label
              ><label class="pa-field"
                ><span data-i18n="application.18"
                  >Años de experiencia comercial</span
                ><b aria-hidden="true">*</b
                ><select name="experience" required>
                  <option value="" data-i18n="application.32">
                    Selecciona una opción
                  </option>
                  <option value="0" data-i18n="application.33">
                    Sin experiencia
                  </option>
                  <option value="under1" data-i18n="application.34">
                    Menos de 1 año
                  </option>
                  <option value="1-3" data-i18n="application.35">
                    1–3 años
                  </option>
                  <option value="4-7" data-i18n="application.36">
                    4–7 años
                  </option>
                  <option value="7+" data-i18n="application.37">
                    Más de 7 años
                  </option>
                </select></label
              ><label class="pa-field"
                ><span data-i18n="application.19"
                  >Clientes activos aproximados</span
                ><b aria-hidden="true">*</b
                ><input
                  name="clients"
                  type="number"
                  min="0"
                  max="100000"
                  step="1"
                  required
                  maxlength="160"
              /></label>
              <fieldset class="pa-solutions pa-wide">
                <legend>
                  <span data-i18n="application.20"
                    >Soluciones que quieres ofrecer</span
                  >
                  *
                </legend>
                <div class="pa-choices">
                  <label
                    ><input type="checkbox" name="solutions" value="web-commerce" /><span
                      data-i18n="application.21"
                      >Web y comercio digital</span
                    ><span aria-hidden="true">↗</span></label
                  ><label
                    ><input type="checkbox" name="solutions" value="automation-systems" /><span
                      data-i18n="application.22"
                      >Automatización y sistemas</span
                    ><span aria-hidden="true">↗</span></label
                  ><label
                    ><input type="checkbox" name="solutions" value="security-data" /><span
                      data-i18n="application.23"
                      >Seguridad y datos</span
                    ><span aria-hidden="true">↗</span></label
                  >
                </div>
              </fieldset>
            </div>
          </section>
          <section
            class="pa-panel"
            data-panel="2"
            hidden
            aria-labelledby="pa-title-2"
          >
            <div class="pa-panel-head">
              <span class="pa-index" aria-hidden="true">03</span>
              <div>
                <h2 tabindex="-1" id="pa-title-2" data-i18n="application.4">
                  Plan comercial
                </h2>
                <p data-i18n="application.53">
                  Define tu disponibilidad y cómo desarrollarías tu actividad.
                </p>
              </div>
            </div>
            <div class="pa-fields">
              <label class="pa-field"
                ><span data-i18n="application.28">Nivel de interés</span
                ><b aria-hidden="true">*</b
                ><select name="level" required>
                  <option value="" data-i18n="application.32">
                    Selecciona una opción
                  </option>
                  <option value="basic" data-i18n="application.29">
                    Básico
                  </option>
                  <option value="advanced" data-i18n="application.30">
                    Avanzado
                  </option>
                  <option value="master" data-i18n="application.31">
                    Master
                  </option>
                </select></label
              ><label class="pa-field"
                ><span data-i18n="application.26"
                  >Horas disponibles por semana</span
                ><b aria-hidden="true">*</b
                ><input
                  name="hours"
                  type="number"
                  min="1"
                  max="80"
                  step="1"
                  required
                  maxlength="160" /></label
              ><label class="pa-field"
                ><span data-i18n="application.27">¿Cuándo podrías empezar?</span
                ><b aria-hidden="true">*</b
                ><select name="start" required>
                  <option value="" data-i18n="application.32">
                    Selecciona una opción
                  </option>
                  <option value="30" data-i18n="application.38">
                    En 30 días
                  </option>
                  <option value="60" data-i18n="application.39">
                    En 60 días
                  </option>
                  <option value="90" data-i18n="application.40">
                    En 90 días
                  </option>
                  <option value="unknown" data-i18n="application.41">
                    Aún por definir
                  </option>
                </select></label
              >
              <p class="pa-hint">
                <span data-i18n="application.61"
                  >La selección de un nivel expresa tu interés; está sujeta a
                  evaluación.</span
                >
              </p>
              <label class="pa-field pa-wide"
                ><span data-i18n="application.25"
                  >¿Cómo conseguirías tus primeros clientes?</span
                ><b aria-hidden="true">*</b
                ><textarea
                  name="strategy"
                  rows="4"
                  required
                  minlength="20"
                  maxlength="1200"
                ></textarea></label
              ><label class="pa-field pa-wide"
                ><span data-i18n="application.24"
                  >Objetivo de los primeros 90 días</span
                ><b aria-hidden="true">*</b
                ><textarea
                  name="goal"
                  rows="4"
                  required
                  minlength="20"
                  maxlength="1200"
                ></textarea>
              </label>
            </div>
          </section>
          <section
            class="pa-panel"
            data-panel="3"
            hidden
            aria-labelledby="pa-title-3"
          >
            <div class="pa-panel-head">
              <span class="pa-index" aria-hidden="true">04</span>
              <div>
                <h2 tabindex="-1" id="pa-title-3" data-i18n="application.5">
                  Revisión
                </h2>
                <p data-i18n="application.54">
                  Revisa cada sección antes de preparar tu resumen.
                </p>
              </div>
            </div>
            <div class="pa-fields">
              <div id="pa-review" class="pa-wide"></div>
              <label class="pa-consent pa-wide"
                ><input type="checkbox" name="confirmed" required /><span
                  data-i18n="application.consent"
                  >Confirmo que la información es correcta y autorizo su envío y tratamiento para evaluar mi postulación.</span
                > <a href="privacidad.html" data-i18n="application.privacyLink">Aviso de privacidad</a></label
              >
              <p
                id="pa-result"
                class="pa-wide"
                role="status"
                aria-live="polite"
                hidden
              ></p>
            </div>
          </section>
          <p id="pa-error" role="alert" hidden data-i18n="application.56">
            Comprueba los campos señalados.
          </p>
          <p id="pa-submit-error" class="pa-wide" role="alert" hidden></p>
          <div class="pa-actions">
            <button id="pa-back" type="button" hidden>
              <span data-i18n="application.42">Anterior</span></button
            ><button id="pa-next" type="button" class="partner-button">
              <span data-i18n="application.43">Continuar</span> →</button
            ><button id="pa-finish" type="submit" class="partner-button" hidden>
              <span data-i18n="application.submit">Enviar postulación</span> ✓
            </button>
          </div>
          <p data-i18n="application.privacySubmission">
            Al enviar, tus respuestas se transmiten al AdminPanel y se almacenan para evaluar la postulación. Los plazos de conservación y demás condiciones están pendientes de revisión antes de publicar.
          </p>
          <a class="pa-privacy" href="privacidad.html"
            >Privacidad y uso del sitio</a
          ><noscript>Activa JavaScript para completar el formulario.</noscript>
        </form>
      </section>
      </div>
    </main>
    <SiteFooter />
    <WhatsAppFlotante />
  </body>
</html>
