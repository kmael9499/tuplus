          <fieldset class="sc-form-group"><legend>Tus datos y tu territorio</legend>
            <label>Nombre *<input name="nombre" type="text" autocomplete="name" required /></label>
            <label>Correo *<input name="correo" type="email" autocomplete="email" required /></label>
            <label>Tel?fono *<input name="telefono" type="text" autocomplete="tel" required /></label>
            <label>Territorio *<select name="territorio_id" required disabled aria-describedby="sc-territorios-status"><option value="">Cargando territorios?</option></select></label>
            <p id="sc-territorios-status" role="status" aria-live="polite"></p>
            <button id="sc-retry" type="button" class="partner-button" hidden>Volver a cargar territorios</button>
            <label>?Por qu? quieres ser Partner? (opcional)<textarea name="mensaje" rows="4"></textarea></label>
          </fieldset>
          <button class="partner-button sc-submit-button" type="submit" disabled>Enviar postulaci?n</button>
          <p id="sc-error" role="alert" hidden style="white-space: pre-line"></p>
          <p id="sc-msg" role="status" aria-live="polite" hidden></p>
          <noscript>Activa JavaScript para cargar los territorios y enviar tu postulaci?n.</noscript>
        </form>
      </div>
    </section>
