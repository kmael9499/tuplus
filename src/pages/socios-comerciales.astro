        <div class="sc-grid">
        <label><span class="sc-label-title">Tipo de socio <span class="sc-required-star">*</span></span><select name="tipo" required><option value="">Elige una opción</option><option>Profesional independiente</option><option>Agencia o consultora</option><option>Empresa</option><option>Otro</option></select></label>
        <label><span class="sc-label-title">Soluciones que te interesan <span class="sc-required-star">*</span></span><select name="soluciones" required><option value="">Elige una opción</option><option>Diseño web</option><option>Tiendas virtuales</option><option>Automatización</option><option>Sistemas a medida</option><option>Datos y seguridad</option><option>Todas</option></select></label>
        </div>
        <label><span class="sc-label-title">¿Cómo llegarías a tus clientes? <span class="sc-required-star">*</span></span><textarea name="mensaje" rows="4" maxlength="1000" placeholder="Cuéntanos qué negocios conoces y cómo les presentarías las soluciones de TUPLUS." required></textarea></label>
        </fieldset>
        <label class="sc-check"><input type="checkbox" name="consent" required><span>Autorizo compartir estos datos con TUPLUS por WhatsApp para atender mi postulación. <a href="privacidad.html">Ver información de privacidad</a>.</span></label>
        <button class="partner-button sc-submit-button" type="submit">Preparar mensaje de WhatsApp <span aria-hidden="true">↗</span></button>
        <p class="sc-note">Tú revisas el mensaje y decides cuándo enviarlo. No pedimos documentos ni datos bancarios.</p>
        <div class="sc-msg" id="sc-msg" role="status" aria-live="polite" hidden><strong>Tu mensaje está preparado.</strong> Si WhatsApp no se abrió automáticamente, <a id="sc-whatsapp-fallback" href="#" target="_blank" rel="noopener noreferrer">ábrelo aquí</a>.</div>
      </form>
    </div></section>
  </main>

  <SiteFooter />

  <script is:inline>
    (function () {
      var f = document.getElementById('sc-form');
      var aviso = document.getElementById('sc-msg');
      if (!f) return;

      // Ubicación por niveles: país -> región/estado/provincia -> ciudad/localidad.
      // La fuente es una base comunitaria que se carga solo cuando se necesita.
      var pais = document.getElementById('sc-pais');
      var regionSelect = document.getElementById('sc-region-select');
      var regionCustomWrap = document.getElementById('sc-region-custom-wrap');
      var regionCustom = document.getElementById('sc-region');
      var regionHint = document.getElementById('sc-region-hint');
      var ciudadSelect = document.getElementById('sc-ciudad-select');
      var ciudadCustomWrap = document.getElementById('sc-ciudad-custom-wrap');
      var ciudadCustom = document.getElementById('sc-ciudad');
      var ciudadHint = document.getElementById('sc-ciudad-hint');
      var locationCache = Object.create(null);
      var selectedCountryData = null;
      var locationBase = 'https://cdn.jsdelivr.net/gh/srestre/world-countries-cities-db@main';

      var countryPicker = document.getElementById('sc-country-picker');
      var countryTrigger = document.getElementById('sc-country-trigger');
      var countryMenu = document.getElementById('sc-country-menu');
      var countrySearch = document.getElementById('sc-country-search');
      var countryOptions = document.getElementById('sc-country-options');
      var currentCountryFlag = document.getElementById('sc-country-current-flag');
      var currentCountryName = document.getElementById('sc-country-current-name');
      var countryError = document.getElementById('sc-country-error');

      function flagEmoji(code) {
        if (!code || !/^[A-Z]{2}$/.test(code)) return '🌐';
        return Array.from(code.toUpperCase()).map(function (letter) {
          return String.fromCodePoint(127397 + letter.charCodeAt(0));
        }).join('');
      }
      function makeFlag(code, alt, className) {
        var img = document.createElement('img');
        img.className = className || 'sc-country-flag-img';
        img.alt = alt || '';
        img.loading = 'lazy';
        img.width = 28;
        img.height = 20;
        img.src = code ? 'https://flagcdn.com/w40/' + code.toLowerCase() + '.png' : '';
        img.srcset = code ? 'https://flagcdn.com/w80/' + code.toLowerCase() + '.png 2x' : '';
        img.onerror = function () {
          var fallback = document.createElement('span');
          fallback.className = 'sc-country-flag-fallback';
          fallback.textContent = flagEmoji(code);
          fallback.setAttribute('aria-hidden', 'true');
          img.replaceWith(fallback);
        };
        if (!code) {
          var fallback = document.createElement('span');
          fallback.className = 'sc-country-flag-fallback';
          fallback.textContent = '🌐';
          return fallback;
        }
        return img;
      }
      function selectedCountryOption() {
        if (!pais || pais.selectedIndex < 0) return null;
        var option = pais.options[pais.selectedIndex];
        return option && option.value ? option : null;
      }
      function syncCountryDisplay() {
        if (!pais || !countryTrigger || !currentCountryFlag || !currentCountryName) return;
        var option = selectedCountryOption();
        currentCountryFlag.replaceChildren();
        var code = option ? option.getAttribute('data-country-code') : '';
        currentCountryFlag.appendChild(makeFlag(code, '', 'sc-country-flag-img'));
        currentCountryName.textContent = option ? option.textContent.trim() : 'Selecciona tu país';
        if (countryError && option) countryError.hidden = true;
        countryTrigger.setAttribute('aria-invalid', option || !countryError || countryError.hidden ? 'false' : 'true');
        if (countryOptions) {
          Array.from(countryOptions.querySelectorAll('[role="option"]')).forEach(function (button) {
            button.setAttribute('aria-selected', option && button.dataset.value === option.value ? 'true' : 'false');
          });
        }
      }
      function closeCountryPicker(returnFocus) {
        if (!countryMenu || !countryTrigger) return;
        countryMenu.hidden = true;
        countryTrigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) countryTrigger.focus();
      }
      function renderCountryOptions(filter) {
        if (!countryOptions || !pais) return;
        var query = String(filter || '').trim().toLocaleLowerCase('es');
        var entries = Array.from(pais.options).filter(function (option) {
          return option.value && option.getAttribute('data-country-code');
        }).sort(function (a, b) { return a.textContent.localeCompare(b.textContent, 'es', { sensitivity: 'base' }); });
        countryOptions.replaceChildren();
        var visible = entries.filter(function (option) {
          return option.textContent.toLocaleLowerCase('es').includes(query) || option.getAttribute('data-country-code').toLowerCase().includes(query);
        });
        if (!visible.length) {
          var empty = document.createElement('p');
          empty.className = 'sc-country-no-results';
          empty.textContent = 'No se encontraron países con ese nombre.';
          countryOptions.appendChild(empty);
          return;
        }
        visible.forEach(function (option) {
          var code = option.getAttribute('data-country-code');
          var item = document.createElement('button');
          item.type = 'button';
          item.className = 'sc-country-option';
          item.setAttribute('role', 'option');
          item.setAttribute('aria-selected', option.value === pais.value ? 'true' : 'false');
          item.dataset.value = option.value;
          item.appendChild(makeFlag(code, '', 'sc-country-flag-img'));
          var name = document.createElement('span');
          name.textContent = option.textContent.trim();
          item.appendChild(name);
          var codeTag = document.createElement('small');
          codeTag.textContent = code;
          item.appendChild(codeTag);
          item.addEventListener('click', function () {
            pais.value = option.value;
            pais.dispatchEvent(new Event('change', { bubbles: true }));
            syncCountryDisplay();
            closeCountryPicker(false);
            if (countrySearch) countrySearch.value = '';
            renderCountryOptions('');
            if (countryTrigger) countryTrigger.focus();
          });
          countryOptions.appendChild(item);
        });
      }
      function initCountryPicker() {
        if (!pais || !countryPicker || !countryTrigger || !countryMenu) return;
        renderCountryOptions('');
        syncCountryDisplay();
        countryTrigger.addEventListener('click', function () {
          var willOpen = countryMenu.hidden;
          countryMenu.hidden = !willOpen;
          countryTrigger.setAttribute('aria-expanded', String(willOpen));
          if (willOpen) {
            renderCountryOptions(countrySearch ? countrySearch.value : '');
            if (countrySearch) countrySearch.focus();
          }
        });
        if (countrySearch) countrySearch.addEventListener('input', function () { renderCountryOptions(countrySearch.value); });
        document.addEventListener('click', function (event) {
          if (countryPicker && !countryPicker.contains(event.target)) closeCountryPicker(false);
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && countryMenu && !countryMenu.hidden) closeCountryPicker(true);
        });
      }
      function setOptions(select, placeholder, entries, getLabel) {
        if (!select) return;
        select.replaceChildren();
        var first = document.createElement('option');
        first.value = '';
        first.textContent = placeholder;
        select.appendChild(first);
        (entries || []).forEach(function (entry) {
          var option = document.createElement('option');
          option.value = getLabel(entry);
          option.textContent = getLabel(entry);
          select.appendChild(option);
        });
        var other = document.createElement('option');
        other.value = '__otra__';
        other.textContent = 'No aparece / escribir manualmente';
        select.appendChild(other);
      }
      function toggleCustom(select, wrapper, input, hint) {
        var custom = select && select.value === '__otra__';
        if (wrapper) wrapper.hidden = !custom;
        if (input) {
          input.required = Boolean(custom);
          if (!custom) input.value = '';
          if (custom) input.focus();
        }
        if (hint) hint.hidden = Boolean(custom);
      }
      function resetRegionAndCity(regionPlaceholder, cityPlaceholder) {
        setOptions(regionSelect, regionPlaceholder, [], function (item) { return item; });
        setOptions(ciudadSelect, cityPlaceholder, [], function (item) { return item; });
        if (regionSelect) regionSelect.disabled = true;
        if (ciudadSelect) ciudadSelect.disabled = true;
        if (regionCustomWrap) regionCustomWrap.hidden = true;
        if (regionCustom) { regionCustom.required = false; regionCustom.value = ''; }
        if (ciudadCustomWrap) ciudadCustomWrap.hidden = true;
        if (ciudadCustom) { ciudadCustom.required = false; ciudadCustom.value = ''; }
        if (regionHint) regionHint.hidden = false;
        if (ciudadHint) ciudadHint.hidden = false;
      }
      function getCountryTree(code) {
        if (locationCache[code]) return Promise.resolve(locationCache[code]);
        return fetch(locationBase + '/countries/' + encodeURIComponent(code) + '.json')
          .then(function (response) {
            if (!response.ok) throw new Error('No fue posible cargar la ubicación');
            return response.json();
          })
          .then(function (data) {
            var countryObject = Array.isArray(data) ? data[0] : data;
            if (!countryObject || !Array.isArray(countryObject.states)) throw new Error('Formato de ubicación no disponible');
            locationCache[code] = countryObject;
            return countryObject;
          });
      }
      function populateCities() {
        var regionName = regionSelect ? regionSelect.value : '';
        var states = selectedCountryData && Array.isArray(selectedCountryData.states) ? selectedCountryData.states : [];
        var chosenRegion = states.find(function (state) { return state.name === regionName; });
        var cities = chosenRegion && Array.isArray(chosenRegion.cities) ? chosenRegion.cities : [];
        cities = cities.map(function (city) { return typeof city === 'string' ? city : city.name; }).filter(Boolean);
        cities = Array.from(new Set(cities)).sort(function (a, b) { return a.localeCompare(b, 'es', { sensitivity: 'base' }); });
        setOptions(ciudadSelect, regionName && regionName !== '__otra__' ? 'Selecciona ciudad o localidad' : 'Selecciona primero una región', cities, function (name) { return name; });
        if (ciudadSelect) ciudadSelect.disabled = !regionName;
        if (ciudadCustomWrap) ciudadCustomWrap.hidden = true;
        if (ciudadCustom) { ciudadCustom.required = false; ciudadCustom.value = ''; }
        if (ciudadHint) {
          ciudadHint.hidden = false;
          ciudadHint.textContent = cities.length ? 'Lista disponible para la región elegida. Si falta tu distrito o localidad, puedes escribirlo.' : 'No hay ciudades registradas para esta región; puedes escribir tu ubicación manualmente.';
        }
      }
      function actualizarUbicacion() {
        if (!pais || !regionSelect || !ciudadSelect) return;
        var option = pais.options[pais.selectedIndex];
        var code = option ? option.getAttribute('data-country-code') : '';
        selectedCountryData = null;
        resetRegionAndCity(code ? 'Cargando regiones…' : 'Primero selecciona un país', 'Primero selecciona una región');
        if (!code) return;
        if (regionHint) regionHint.textContent = 'Buscando departamentos, estados o regiones…';
        if (ciudadHint) ciudadHint.textContent = 'Después podrás elegir una ciudad o localidad.';
        getCountryTree(code).then(function (countryObject) {
          // Evita que una respuesta lenta de otro país reemplace la selección más reciente.
          var current = pais.options[pais.selectedIndex];
          if (!current || current.getAttribute('data-country-code') !== code) return;
          selectedCountryData = countryObject;
          var regions = (countryObject.states || []).map(function (state) { return state.name; }).filter(Boolean);
          regions = Array.from(new Set(regions)).sort(function (a, b) { return a.localeCompare(b, 'es', { sensitivity: 'base' }); });
          setOptions(regionSelect, regions.length ? 'Selecciona departamento / región' : 'No hay regiones registradas', regions, function (name) { return name; });
          regionSelect.disabled = false;
          if (regionHint) regionHint.textContent = regions.length ? 'Elige una región para ver sus ciudades y localidades.' : 'No hay regiones registradas en la base. Usa “escribir manualmente”.';
          populateCities();
        }).catch(function () {
          var current = pais.options[pais.selectedIndex];
          if (!current || current.getAttribute('data-country-code') !== code) return;
          selectedCountryData = null;
          setOptions(regionSelect, 'No se pudo cargar la lista', [], function (name) { return name; });
          regionSelect.disabled = false;
          setOptions(ciudadSelect, 'Selecciona primero la región', [], function (name) { return name; });
          ciudadSelect.disabled = false;
          if (regionHint) regionHint.textContent = 'No se pudo cargar la base de ubicaciones. Puedes escribir la región manualmente.';
          if (ciudadHint) ciudadHint.textContent = 'Puedes escribir la ciudad, distrito o localidad manualmente.';
        });
      }
      if (pais) {
        pais.addEventListener('change', function () {
          syncCountryDisplay();
          actualizarUbicacion();
        });
        initCountryPicker();
      }
      if (regionSelect) regionSelect.addEventListener('change', function () {
        toggleCustom(regionSelect, regionCustomWrap, regionCustom, regionHint);
        if (ciudadSelect) {
          ciudadSelect.value = '';
          ciudadSelect.disabled = false;
        }
        populateCities();
      });
      if (ciudadSelect) ciudadSelect.addEventListener('change', function () {
        toggleCustom(ciudadSelect, ciudadCustomWrap, ciudadCustom, ciudadHint);
      });
      resetRegionAndCity('Primero selecciona un país', 'Primero selecciona una región');

      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!pais || !pais.value) {
          if (countryError) countryError.hidden = false;
          if (countryTrigger) {
            countryTrigger.setAttribute('aria-invalid', 'true');
            countryTrigger.focus();
          }
          return;
        }
        if (!f.reportValidity()) return;
        var d = new FormData(f);
        function v(k) { return String(d.get(k) || '').trim(); }
        var texto = 'Hola, quiero postular a la Red de Socios Comerciales de TUPLUS.\n\n' +
          'Nombre: ' + v('nombre') + '\n' +
          'Empresa o actividad: ' + v('empresa') + '\n' +
          'Contacto: ' + v('contacto') + '\n' +
          'País: ' + v('pais') + '\n' +
          'Departamento / estado / región: ' + (v('region') || (v('region-opcion') === '__otra__' ? 'No indicado' : v('region-opcion'))) + '\n' +
          'Ciudad / distrito / localidad: ' + (v('ciudad') || (v('ciudad-opcion') === '__otra__' ? 'No indicado' : v('ciudad-opcion'))) + '\n' +
          'Tipo de socio: ' + v('tipo') + '\n' +
          'Soluciones de interés: ' + v('soluciones') + '\n' +
          'Cómo llegaría a mis clientes: ' + v('mensaje');
        var url = 'https://wa.me/51916828870?text=' + encodeURIComponent(texto);
        var enlaceAlternativo = document.getElementById('sc-whatsapp-fallback');
        if (enlaceAlternativo) enlaceAlternativo.href = url;
        window.open(url, '_blank', 'noopener,noreferrer');
        aviso.hidden = false;
      });
    })();
  </script>
