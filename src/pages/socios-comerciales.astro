          <div class="sc-country-picker" id="sc-country-picker">
            <button class="sc-country-trigger" id="sc-country-trigger" type="button" aria-labelledby="sc-country-label" aria-haspopup="listbox" aria-expanded="false" aria-controls="sc-country-options" aria-required="true">
              <span class="sc-country-current-flag" id="sc-country-current-flag" aria-hidden="true">🌐</span>
              <span class="sc-country-current-name" id="sc-country-current-name">Selecciona tu país</span>
              <svg class="sc-country-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="sc-country-menu" id="sc-country-menu" hidden>
              <label class="sc-country-search-label">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                <input type="search" id="sc-country-search" placeholder="Buscar país…" autocomplete="off" aria-label="Buscar país">
              </label>
              <div class="sc-country-options" id="sc-country-options" role="listbox" aria-label="Países"></div>
