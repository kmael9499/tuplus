---
import GlobalAudio from '../components/GlobalAudio.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#122c3d" />
  <title>Área de socios | TUPLUS</title><meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="imagenes/marca/simbolo-oscuro.png" /><link rel="stylesheet" href="css/style.css" /><link rel="stylesheet" href="css/theme.css" /><link rel="stylesheet" href="css/acceso.css" />
  <script is:inline src="js/theme.js"></script><script is:inline src="js/auth-config.js"></script><script is:inline defer src="js/portal-socios.js"></script>
</head>
<body class="access-page">
  <header class="access-header"><a class="brand" href="index.html" aria-label="TUPLUS, inicio"><span class="brand-art"><img class="brand-light" src="imagenes/marca/logo-claro.png" alt="TUPLUS" width="2172" height="724"><img class="brand-dark" src="imagenes/marca/logo-claro.png" alt="TUPLUS" width="2172" height="724"></span></a><button class="back-link portal-logout" id="logout" type="button">Cerrar sesión</button></header>
  <main id="contenido" class="access-main" tabindex="-1"><section class="access-card" aria-labelledby="portal-title"><span class="access-mark" aria-hidden="true">✳</span><p class="eyebrow">ÁREA PRIVADA</p><h1 id="portal-title">Hola, <span id="member-name">socio</span>.</h1><p class="access-intro" id="portal-state" role="status" aria-live="polite">Comprobando tu sesión segura…</p><div class="portal-content" id="portal-content" hidden><p>Tu acceso a la Red de Socios está activo.</p><p class="portal-email" id="member-email"></p></div><a class="button button-dark full-width" href="red-socios.html">Volver a la Red <span aria-hidden="true">→</span></a></section><p class="security-note">Esta área requiere una cuenta TUPLUS activa.</p></main>
  <GlobalAudio />
</body>
</html>


