<style is:inline>
  /* ===== Tarjeta SaaS ===== */
  .choice-card[data-key="webapp"]{
    position:relative !important;
    min-height:0 !important; height:auto !important;
    align-items:center !important; align-content:center !important;
    padding-block:22px !important;
    overflow:visible;
    box-shadow:inset 0 0 70px rgba(232,201,138,.07), 0 0 0 1px rgba(232,201,138,.12);
  }
  .choice-card[data-key="webapp"]::after{
    content:""; position:absolute; right:0; top:0; bottom:0; width:42%;
    background:radial-gradient(ellipse at 80% 50%, rgba(232,201,138,.16), transparent 70%);
    pointer-events:none; border-radius:inherit;
  }

  /* ===== Botón ===== */
  .choice-card .pedir-cotizacion{
    position:relative; z-index:2; overflow:hidden;
    display:inline-flex; align-items:center; align-self:center !important; gap:10px;
    padding:9px 10px 9px 20px; border-radius:999px;
    border:1px solid rgba(255,226,150,.65);
    background:linear-gradient(135deg,#f3d98f 0%,#d9ae55 55%,#c4943a 100%);
    color:#1b1405 !important; -webkit-text-fill-color:#1b1405;
    font-family:'Manrope',system-ui,sans-serif !important;
    font-size:13.5px; font-weight:800; letter-spacing:.03em;
    text-decoration:none; text-shadow:none; white-space:nowrap; cursor:pointer;
    box-shadow:0 4px 18px rgba(217,174,85,.28), inset 0 1px 0 rgba(255,255,255,.45);
    transition:transform .25s ease, box-shadow .25s ease, filter .25s ease;
  }
  .choice-card .pedir-cotizacion::after{
    content:"→"; display:inline-grid; place-items:center;
    width:26px; height:26px; border-radius:50%;
    background:#1b1405; color:#f3d98f; -webkit-text-fill-color:#f3d98f;
    font-size:14px; line-height:1; transition:transform .25s ease;
  }
  .choice-card .pedir-cotizacion::before{
    content:""; position:absolute; top:0; left:-60%; width:40%; height:100%;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);
    transform:skewX(-20deg); transition:left .6s ease;
  }
  .choice-card .pedir-cotizacion:hover,
  .choice-card .pedir-cotizacion:focus-visible{
    transform:translateY(-1px); filter:brightness(1.06);
    box-shadow:0 8px 26px rgba(217,174,85,.45), inset 0 1px 0 rgba(255,255,255,.5);
    outline:none;
  }
  .choice-card .pedir-cotizacion:hover::before,
  .choice-card .pedir-cotizacion:focus-visible::before{ left:120% }
  .choice-card .pedir-cotizacion:hover::after{ transform:translateX(3px) }
  .choice-card .pedir-cotizacion:active{ transform:translateY(0) scale(.98) }

  /* ===== Colibrí ===== */
  .pc-bird{
    position:absolute; z-index:3; pointer-events:none;
    top:50%; right:230px; width:58px; height:58px;
    margin-top:-29px;
    opacity:0; transform:translateX(-140px) scale(.7) rotate(-8deg);
    transition:opacity .35s ease, transform .6s cubic-bezier(.2,.9,.3,1.2);
    filter:saturate(1.5) brightness(1.2) drop-shadow(0 0 6px #ffc83d) drop-shadow(0 0 18px rgba(255,190,50,.55));
  }
  .pc-bird img{ width:100%; height:100%; object-fit:contain; display:block }
  .choice-card.pc-on .pc-bird{
    opacity:1; transform:translateX(0) scale(1) rotate(0);
    animation:pc-flotar 1.6s ease-in-out .6s infinite;
  }
  .choice-card.pc-on .pc-bird img{ animation:pc-aleteo .22s ease-in-out infinite alternate }
  @keyframes pc-flotar{
    0%,100%{ translate:0 0 } 50%{ translate:0 -8px }
  }
  @keyframes pc-aleteo{
    from{ transform:scaleY(1) rotate(-2deg) } to{ transform:scaleY(.9) rotate(2deg) }
  }

  @media (max-width:640px){
    .choice-card .pedir-cotizacion{ padding:7px 8px 7px 14px; font-size:12.5px; gap:8px }
    .choice-card .pedir-cotizacion::after{ width:22px; height:22px; font-size:12px }
    .pc-bird{ width:40px; height:40px; margin-top:-20px; top:14px; right:70px }
  }
  @media (prefers-reduced-motion:reduce){
    .choice-card .pedir-cotizacion,
    .choice-card .pedir-cotizacion::before,
    .choice-card .pedir-cotizacion::after,
    .pc-bird{ transition:opacity .2s }
    .choice-card.pc-on .pc-bird,
    .choice-card.pc-on .pc-bird img{ animation:none }
  }
    .pc-bird{ pointer-events:auto; cursor:pointer }
  .pc-polen{
    position:absolute; z-index:4; pointer-events:none;
    width:7px; height:7px; border-radius:50%;
    background:radial-gradient(circle,#fff6c9 0%,#ffc83d 60%,transparent 100%);
    box-shadow:0 0 8px rgba(255,200,61,.9);
  }
</style>
<script is:inline>
(function(){
  var el=document.querySelector('.pedir-cotizacion'); if(!el) return;
  var card=el.closest('.choice-card');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function abrirWA(){
    var wa=document.getElementById('floatingWhatsapp')||document.querySelector('a[href*="wa.me"],a[href*="whatsapp.com"]');
    var base=wa ? wa.href.split('?')[0] : '';
    if(!/wa\.me|whatsapp/.test(base)) return;
    window.open(base+'?text='+encodeURIComponent(el.dataset.waMsg),'_blank','noopener');
  }

  function polen(){
    if(!card||reduce||!card.animate) return;
    var c=card.getBoundingClientRect(), b=el.getBoundingClientRect();
    var x=b.left+b.width/2-c.left, y=b.top+b.height/2-c.top;
    for(var i=0;i<14;i++){
      var p=document.createElement('span'); p.className='pc-polen';
      p.style.left=x+'px'; p.style.top=y+'px';
      card.appendChild(p);
      var ang=Math.random()*Math.PI*2, d=40+Math.random()*60;
      var a=p.animate([
        {transform:'translate(-50%,-50%) scale(1)',opacity:1},
        {transform:'translate(calc(-50% + '+Math.cos(ang)*d+'px),calc(-50% + '+(Math.sin(ang)*d-10)+'px)) scale(.2)',opacity:0}
      ],{duration:650+Math.random()*350,easing:'cubic-bezier(.2,.8,.3,1)'});
      a.onfinish=(function(n){return function(){n.remove();};})(p);
    }
  }

  if(card){
    var bird=document.createElement('span');
    bird.className='pc-bird'; bird.setAttribute('aria-hidden','true');
    var ref=document.querySelector('img[src$="colibri.png"]');
    var src=ref ? ref.getAttribute('src') : 'colibri.png';
    bird.innerHTML='<img src="'+src+'" alt="" width="58" height="58">';
    card.appendChild(bird);

    var t, busy=false;
    function on(){ clearTimeout(t); card.classList.add('pc-on'); }
    function off(d){ clearTimeout(t); t=setTimeout(function(){ if(!busy) card.classList.remove('pc-on'); }, d); }
    function delay(e){ return e&&e.pointerType==='touch' ? 1400 : 350; }

    [el,bird].forEach(function(n){
      n.addEventListener('pointerenter',on);
      n.addEventListener('pointerleave',function(e){ off(delay(e)); });
    });
    el.addEventListener('pointerdown',on);
    el.addEventListener('focus',on);
    el.addEventListener('blur',function(){ off(0); });

    /* Tocar el colibrí: picada hacia el botón, polen y WhatsApp */
    bird.addEventListener('click',function(e){
      e.preventDefault(); e.stopPropagation();
      if(busy) return; busy=true;
      if(reduce||!bird.animate){ abrirWA(); busy=false; return; }
      var br=bird.getBoundingClientRect(), er=el.getBoundingClientRect();
      var dx=(er.left+er.width/2)-(br.left+br.width/2);
      var dy=(er.top+er.height/2)-(br.top+br.height/2);
      var a=bird.animate([
        {transform:'translateX(0) scale(1) rotate(0)',opacity:1},
        {transform:'translate('+(dx*.55)+'px,'+(dy*.55-24)+'px) scale(1.25) rotate(10deg)',opacity:1,offset:.5},
        {transform:'translate('+dx+'px,'+dy+'px) scale(.25) rotate(14deg)',opacity:0}
      ],{duration:650,easing:'ease-in',fill:'forwards'});
      a.onfinish=function(){
        polen(); abrirWA();
        card.classList.remove('pc-on'); a.cancel(); busy=false;
      };
    });
  }

  /* Tocar el botón: polen y WhatsApp directo */
  function click(e){ e.preventDefault(); e.stopPropagation(); polen(); abrirWA(); }
  el.addEventListener('click',click);
  el.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' ') click(e); });
})();
</script>
</html>


