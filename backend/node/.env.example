# Copia este archivo como .env y completa tus datos. El .env NO se sube a GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=cotizador_db
PORT=8080
# Tipo de cambio (soles por 1 USD) para guardar el total en USD. Actualízalo cuando cambie.
PEN_POR_USD=3.3923
# Orígenes (la web) que pueden llamar a la API con sesión, separados por comas.
CORS_ORIGINS=http://localhost:4321
# Inicio de sesión (auth.js): secreto largo y aleatorio para los códigos de verificación.
AUTH_TOKEN_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
# Correo (Resend) para códigos y recuperación de contraseña.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_APP_URL=http://localhost:4321
